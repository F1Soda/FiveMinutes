@using FiveMinute.Application.Helpers
@model ICollection<FiveMinute.ViewModels.FMTEditViewModels.FMTemplateIndexViewModel>

@{

}

@if (Model != null && Model.Any())
{
    <table class="table">
        <thead>
            <tr>
                <th>ID</th>
                <th>Название</th>
                <th>Последнее изменение</th>
                <th>Действия</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var template in Model)
            {
                <tr>
                    <td>@template.Id</td>
                    <td><div class="" title="@template.Name">@template.Name</div></td>
                    <td>@TimeAgoHelper.GetTimeAgoString(template.lastModification, TimeZoneInfo.Local)</td>
                    <td>
                        <a asp-action="Edit" asp-controller="FiveMinuteTemplate" asp-route-Id="@template.Id" class="btn btn-primary">Редактировать</a>
                        <button class="btn btn-danger btn-delete" id="delete-template" data-id="@template.Id">Удалить</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="text-center p-2"><p>Пока тут пусто. Создайте новую!</p></div>
}

@using FiveMinute.Data
@model ICollection<FiveMinute.ViewModels.FiveMinuteTestViewModels.FMTestIndexViewModel>

@{
	string GetStatusClass(TestStatus status)
	{
		return status switch
		{
			TestStatus.Planned => "bg-warning",
			TestStatus.Started => "bg-primary",
			TestStatus.InRechekingProcess => "bg-brown",
			TestStatus.Completed => "bg-success",
			TestStatus.Closed => "bg-danger",
			_ => "bg-light"
		};
	}

	string ConvertEnumToString(TestStatus status)
	{
		return status switch
		{
			TestStatus.Planned => "Запланирована",
			TestStatus.Started => "Активна",
			TestStatus.InRechekingProcess => "Требует проверки",
			TestStatus.Completed => "Завершена",
			TestStatus.Closed => "Закрыта",
			_ => "Неизвестный статус"
		};
	}
}

@if (Model != null && Model.Any())
{
	<table class="table">
		<thead>
			<tr>
				<th>ID</th>
				<th>Название</th>
				<th>Статус</th>
				<th>Прикрепленная пятиминутка</th>
				<th>Действия</th>
			</tr>
		</thead>
		<tbody>
			@foreach (var test in Model)
			{
				<tr>
					<td>@test.Id</td>
					<td>@test.Name</td>
					<td>
						<span class="badge @GetStatusClass(test.Status) text-white">
							@ConvertEnumToString(test.Status)
						</span>

						@if (test.StartPlanned || test.EndPlanned)
						{
							@if (test.isActive)
							{
								<span class="badge @GetStatusClass(TestStatus.Started) text-white">@ConvertEnumToString(TestStatus.Started)</span>
							}
							else
							{
								<span class="badge @GetStatusClass(TestStatus.Closed) text-white">@ConvertEnumToString(TestStatus.Closed)</span>
							}

						}



					</td>
					<td>@test.AttachedFMTemplateName</td>
					<td>
						<a class="btn btn-secondary" id="copyUrlButton" encryptedId="@test.EncryptedId">Скопировать ссылку</a>
						<a class="btn btn-primary" asp-area="" asp-route-testId="@test.Id" asp-controller="FiveMinuteTest" asp-action="Detail">Подробнее</a>

						<button class="btn btn-danger btn-delete" id="delete-test" data-id="@test.Id">Удалить</button>
					</td>
				</tr>
			}
		</tbody>
	</table>
}
else
{
	<div class="text-center p-2"><p>Пока тут пусто. Создайте новую!</p></div>
}

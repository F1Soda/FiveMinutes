@using FiveMinute.Data
@using FiveMinute.Application.Helpers
@model ICollection<FiveMinute.ViewModels.FiveMinuteTestViewModels.FMTestIndexViewModel>


@if (Model != null && Model.Any())
{
	<table class="table">
		<thead>
			<tr>
				<th>ID</th>
				<th>Название</th>
				<th>Статус</th>
				<th>Прикрепленная пятиминутка</th>
				<th>Действия</th>
			</tr>
		</thead>
		<tbody>
			@foreach (var test in Model)
			{
				<tr>
					<td>@test.Id</td>
					<td>@test.Name</td>
					<td>
						<span class="badge @TestStatusHelper.GetStatusClass(test.Status) text-white">@TestStatusHelper.ConvertEnumToString(test.Status)</span>

						@if (test.EndPlanned || test.StartPlanned)
						{
							<span id="sub-status" class="badge bg-warning text-white">Запланирована</span>
						}
					</td>
					<td>@test.AttachedFMTemplateName</td>
					<td>
						<a class="btn btn-secondary copyUrlButton" encryptedId="@test.EncryptedId">Скопировать ссылку</a>

						<a class="btn btn-primary" asp-area="" asp-route-testId="@test.Id" asp-controller="FiveMinuteTest" asp-action="Detail">Подробнее</a>

						<button class="btn btn-danger btn-delete" id="delete-test" data-id="@test.Id">Удалить</button>
					</td>
				</tr>
			}
		</tbody>
	</table>
}
else
{
	<div class="text-center p-2"><p>Пока тут пусто. Создайте новую!</p></div>
}

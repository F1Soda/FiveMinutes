@using FiveMinute.Application.Helpers
@using FiveMinute.Data
@model FiveMinute.ViewModels.FiveMinuteTestViewModels.FiveMinuteTestDetailViewModel

<partial name="_Popup" />

@{
	ViewData["Title"] = "Детали теста";
}

<div class="container mt-4">
	<div class="container">
		<div class="row pb-3">
			<div class="col d-flex align-items-center justify-content-between">
				<h1 class="mb-0">@Model.Name</h1>

				<div class="">
					@* @if (Model.HasUncheckedAnswers) *@
					@* { *@
					@* 	<a class="btn btn-primary" asp-area="" asp-route-id="@Model.Id" asp-controller="FiveMinuteTest" asp-action="Checking" >Проверка ответов</a> *@
					@* } *@
					<a class="btn btn-secondary" id="copyUrlButton" encryptedId="@Model.EncryptedId">Скопировать ссылку</a>
					<a class="btn btn-secondary" asp-area="" asp-route-encryptedId="@Model.EncryptedId" asp-controller="FiveMinuteTest" asp-action="Pass">Прохождение теста</a>
					<input id="closeTest" type="button" class="btn btn-danger btn-delete" @(Model.Status == TestStatus.Open ? "" : "hidden") value="Закрыть" />
					<input id="openTest" type="button" class="btn btn-primary" @(Model.Status == TestStatus.Closed ? "" : "hidden") value="Открыть" />
				</div>

			</div>
		</div>

		<p>
			Статус теста:
			<span class="badge @TestStatusHelper.GetStatusClass(Model.Status) text-white">@TestStatusHelper.ConvertEnumToString(Model.Status)</span>

			@if (Model.EndPlanned || Model.StartPlanned)
			{
				<span id="sub-status" class="badge bg-warning text-white">Запланирована</span>
			}

		</p>
		<p>
			Привязанная пятиминутка:
			<a asp-action="Edit" asp-controller="FiveMinuteTemplate" asp-route-Id="@Model.AttachedFMTId">
				@Model.AttachedFMT.Name
			</a>
		</p>


		@if (Model.StartPlanned)
		{
			<p>Запланированное время начала: @Model.StartTime.ToLocalTime()</p>
		}

		@if (Model.EndPlanned)
		{
			<p>Запланированное время окончания: @Model.EndTime.ToLocalTime()</p>
		}


	</div>


	<!-- Tab Navigation -->
	<ul class="nav nav-tabs" id="testDetailTabs" role="tablist">
		<li class="nav-item" role="presentation">
			<a class="nav-link active" id="statistics-tab" data-bs-toggle="tab" href="#statistics" role="tab"
			   aria-controls="statistics" aria-selected="true">Статистика</a>
		</li>
		<li class="nav-item" role="presentation">
			<a class="nav-link" id="settings-tab" data-bs-toggle="tab" href="#settings" role="tab"
			   aria-controls="settings" aria-selected="false">Настройки</a>
		</li>
	</ul>

	<!-- Tab Content -->
	<div class="tab-content mt-3" id="testDetailTabsContent">
		@{
			var startDateString = "";
			var endDateString = "";
			if (Model.StartTime != default)
				startDateString = Model.StartTime.ToLocalTime().ToString("yyyy-MM-ddTHH:mm");
			if (Model.EndTime != default)
				endDateString = Model.EndTime.ToLocalTime().ToString("yyyy-MM-ddTHH:mm");
		}
		<!-- Statistics Tab Pane -->
		<div class="tab-pane fade show active" id="statistics" role="tabpanel" aria-labelledby="statistics-tab">
			<div class="row">
				<div>
					<h6>Всего прохождений: @Model.Results.Count()</h6>

					@foreach (var result in Model.Results)
					{
						var answersDict = new Dictionary<int, List<UserAnswer>>();
						foreach (var answer in result.Answers)
						{
							answersDict.TryAdd(answer.QuestionPosition, new List<UserAnswer>());
							answersDict[answer.QuestionPosition].Add(answer);
						}
						<div class="container-fluid">
							<div class="row">
								<div class="col-12">

									<div class="card my-3">
										<div class="card-header d-flex justify-content-between align-items-center">
											<div>
												<strong>Имя пользователя:</strong> @result.UserData.FirstName @result.UserData.LastName<br />
												<strong>Время прохождения:</strong> @result.PassTime.ToLocalTime()<br />
												<strong>Всего баллов:</strong> @answersDict.Values.SelectMany(x => x).Where(x => x.IsCorrect).Sum(x => x.Score)
											</div>
											<a asp-action="FiveMinuteResult" asp-route-resultId="@result.Id" class="btn btn-primary btn-sm">Подробнее</a>
										</div>

										<div class="card-body">
											<table class="table table-bordered table-striped mt-3">
												<thead class="table">
													<tr>
														<th>Вопрос</th>
														@foreach (var number in answersDict.Keys.Order())
														{
															var someAnswer = answersDict[number].FirstOrDefault();
															<th>@(someAnswer?.QuestionPosition + 1). @someAnswer?.QuestionText</th>
														}
													</tr>
												</thead>
												<tbody>
													<tr>
														<th>Ответ</th>
														@foreach (var number in answersDict.Keys.Order())
														{
															<td>
																@foreach (var answer in answersDict[number].Where(x => !string.IsNullOrEmpty(x.Text)))
																{
																	<div class="answer-block mb-2">
																		<span class="answer-text">@answer.Text</span>
																		@if (Model.AttachedFMT.Questions.FirstOrDefault(q => q.Id == answer.QuestionId) == null)
																		{
																			continue;
																		}
																		@if (Model.AttachedFMT.Questions.FirstOrDefault(q => q.Id == answer.QuestionId).ResponseType == ResponseType.Text)
																		{
																			<div class="mt-2">
																				<button type="button"
																						class="btn btn-sm btn-success mark-correct-btn"
																						data-answer-id="@answer.Id" data-is-correct="true"
																						data-question-position="@answer.QuestionPosition"
																						data-question-id="@answer.QuestionId"
																						data-test-id="@Model.Id"
																						data-answer-text="@answer.Text"
																						data-answer-result-id="@result.Id">
																					Правильно
																				</button>
																				<button type="button"
																						class="btn btn-sm btn-danger mark-correct-btn"
																						data-answer-id="@answer.Id" data-is-correct="false"
																						data-question-position="@answer.QuestionPosition"
																						data-question-id="@answer.QuestionId"
																						data-test-id="@Model.Id"
																						data-answer-text="@answer.Text"
																						data-answer-result-id="@result.Id">
																					Неправильно
																				</button>
																			</div>
																		}
																	</div>
																}
															</td>
														}
													</tr>
													<tr>
														<th>Балл</th>
														@foreach (var number in answersDict.Keys.Order())
														{
															<td>
																<div id="@($"{result.Id}.{answersDict[number].First()?.QuestionId}")">
																	@answersDict[number].Where(x => x.IsCorrect).Sum(x => x.Score)
																</div>
															</td>
														}
													</tr>
												</tbody>
											</table>
										</div>
									</div>
								</div>
							</div>
						</div>
					}

				</div>
			</div>
		</div>

		<script>
			document.addEventListener('DOMContentLoaded', function() {
				initializeQuestionCheckboxes('IdToUninclude');
				toggleEndTimeInput();
				toggleStartTimeInput();

				document.addEventListener('click', function (e) {
					if (e.target.classList.contains('mark-correct-btn')) {
						var answerId = e.target.getAttribute('data-answer-id');
						var isCorrect = e.target.getAttribute('data-is-correct') === 'true';
						var questionId = e.target.getAttribute("data-question-id");
						var testId = e.target.getAttribute("data-test-id");
						var text = e.target.getAttribute("data-answer-text");
						var resultId = e.target.getAttribute("data-answer-result-id");

						fetch('@Url.Action("UpdateAnswerCorrectness", "FiveMinuteTest")', {
							method: 'POST',
							headers: {
								'Content-Type': 'application/json'
							},
							body: JSON.stringify({
								answerId: parseInt(answerId), isCorrect: isCorrect,
								questionId: parseInt(questionId), testId: parseInt(testId),
								text: text, resultId: resultId
							}),
						})
							.then(response => {
								if (!response.ok) throw new Error('Network response was not ok');
								console.log();
								return response.json();
							})
							.then(data => {
								showPopup('Ответ обновлён!', "notification");
								console.log(data);
								// Construct the unique ID of the score block using resultId and questionId
				var scoreBlockId = `${resultId}.${questionId}`;
				var scoreBlock = document.getElementById(scoreBlockId);

				if (scoreBlock) {
					// Update the content of the score block with the new score
					scoreBlock.textContent = data.newScore;
				}
							})
							.catch(error => {
								console.error('Fetch error:', error);
								showPopup('Ошибка при обновлении ответа.', "error");
							});
					}
				});
			});
		</script>


		<div class="tab-pane fade" id="settings" role="tabpanel" aria-labelledby="settings-tab">

			<form method="post" action="@Url.Action("UpdateTestSettings", "FiveMinuteTest")">
				@* <div asp-validation-summary="ModelOnly" class="text-danger"></div> *@
				<input type="hidden" name="Id" value="@Model.Id" />
				<input type="hidden" name="Name" value="@Model.Name" />
				<input type="hidden" name="Status" value="@Model.Status" />
				@* Id и имена разные, не запутайтесь *@
				<input type="hidden" id="IdToUninclude" asp-for="IdToUnincludeAsString" />

				<div class="form-group mb-4">
					<h4>Название</h4>
					@* Не осуждайте меня. Эта залупа ни в какую не хочет сохранять имя в существующий параметр. Придумал такой костыль *@
					<input asp-for="kekForKek" type="text" id="kekForKek" class="form-control" value="@Model.Name" />
				</div>

				<div class="mb-4">
					<h4>Управление вопросами</h4>
					<p>Укажите вопросы, которые буду включены в данный тест</p>
					<div class="list-group">
						@for (int i = 0; i < Model.AttachedFMT.Questions.Count; i++)
						{
							var question = Model.AttachedFMT.Questions[i];
							bool isChecked = !Model.IdToUninclude.Contains(question.Id);
							<div class="list-group-item d-flex justify-content-between align-items-center">
								<div>
									<span class="question-text">@question.QuestionText</span>
								</div>
								<div class="form-check">
									<input type="checkbox"
										   class="form-check-input question-checkbox"
										   data-question-id="@question.Id"
										   value="@question.Id"
									@(isChecked ? "checked" : "") />
								</div>
							</div>
						}
					</div>
				</div>


				<div class="mb-4">
					<h4>Запланировать время</h4>
					<div class="d-flex align-items-center">
						<label for="startPlanned" class="form-label me-2">Запланировать начало</label>
						@if (Model.StartPlanned)
						{
							<input class="form-check-input" type="checkbox" id="startPlanned" asp-for="StartPlanned"
								   onchange="toggleStartTimeInput()" checked />
						}
						else
						{
							<input class="form-check-input" type="checkbox" id="startPlanned" asp-for="StartPlanned"
								   onchange="toggleStartTimeInput()" />
						}
					</div>

					<div id="startTimeInput" class="mt-2" style="display: @(Model.StartPlanned ? "block" : "none")">
						<label for="startDateTime" class="form-label">Дата и время начала</label>
						<input type="datetime-local" id="startDateTime" asp-for="StartTime" class="form-control"
							   value="@startDateString" />
						<span asp-validation-for="IsValidDateRange"></span>
					</div>
				</div>

				<div class="mb-3">
					<div class="d-flex align-items-center">
						<label for="endPlanned" class="form-label me-2">Запланировать окончание </label>
						@if (Model.EndPlanned)
						{
							<input type="checkbox" id="endPlanned" asp-for="EndPlanned" class="form-check-input"
								   onchange="toggleEndTimeInput()" checked />
						}
						else
						{
							<input type="checkbox" id="endPlanned" asp-for="EndPlanned" class="form-check-input"
								   onchange="toggleEndTimeInput()" />
						}
					</div>
					<div id="endTimeInput" class="mt-2" style="display: @(Model.EndPlanned ? "block" : "none")">
						<label for="endDateTime" class="form-label">Дата и время окончания</label>
						<input type="datetime-local" id="endDateTime" asp-for="EndTime" class="form-control"
							   value="@endDateString" />
						<span asp-validation-for="IsValidDateRange"></span>
					</div>
				</div>

				<button type="submit" , id="submit" class="btn btn-primary">Сохранить изменения</button>
			</form>
		</div>
	</div>
</div>

@section Scripts {
	<script>
		const questionCount = @Model.AttachedFMT.Questions.Count;
		let testIsOpen = @((Model.Status == TestStatus.Open).ToString().ToLower());
		let testId = '@Model.Id';
		const buttonOpenTest = document.getElementById('openTest');
		const buttonCloseTest = document.getElementById('closeTest');
	</script>
	<script src="~/js/questionCheckboxHandler.js"></script>
	<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
	<script src="~/js/popup.js"></script>
	<script src="~/js/FMTest/detail.js"></script>

}
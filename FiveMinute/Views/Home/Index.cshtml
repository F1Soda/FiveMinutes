@using FiveMinute.Application.ViewModels.HomeViewModels
@using FiveMinute.Application.Helpers
@model FiveMinute.ViewModels.HomeViewModels.IndexViewModel

<partial name="_Popup" />

@if (Model != null)
{
	@if (Model.UserRole == "teacher" || Model.UserRole == "admin")
	{
		<div class="full-width-wrapper">
			<div class="d-flex justify-content-center bg-light-blue pt-3">
				<div id="TestCardsRow" class="row container justify-content-center">
					@await Html.PartialAsync("_TestCardsRow", new CardRowTestInfoViewModel(Model.ActiveFMTests, Model.RequiresRecheckingFMTests, Model.PlannedFMTests))
				</div>
			</div>
		</div>

		<div class="pt-3">
			<!-- Tabs -->
			<ul class="nav nav-tabs">
				<li class="nav-item">
					<a class="nav-link active" data-toggle="tab" href="#fiveMinuteTemplates">Шаблоны</a>
				</li>
				<li class="nav-item">
					<a class="nav-link" data-toggle="tab" href="#fiveMinuteTests">Тесты</a>
				</li>
			</ul>

			<div class="tab-content">
				<div id="fiveMinuteTemplates" class="tab-pane fade show active">
					<div id="FMTemplateTable">
						@await Html.PartialAsync("_TemplatesTable", Model.FMTemplates)
					</div>
					<l1 class="nav-item">
						<a class="btn btn-success" asp-area="" asp-controller="FiveMinuteTemplate" asp-action="Create">Создать пятиминутку</a>
					</l1>
				</div>
				<div id="fiveMinuteTests" class="tab-pane fade">
					<div id="FMTestTable">
						@await Html.PartialAsync("_TestsTable", Model.FMTests)
					</div>
					<l1 class="nav-item">
						<a class="btn btn-success" asp-area="" asp-controller="FiveMinuteTest" asp-action="Create">Создать тест</a>
					</l1>
				</div>
			</div>
		</div>
	}
	else
	{
		<div class="full-width-wrapper">
			<div class="d-flex justify-content-center bg-light-blue pt-3">
				<div id="TestCardsRow" class="row container justify-content-center">
					@foreach (var quote in Model.Quotes.Take(3))
					{
						<div class="col-md-4 mb-3">
							<div class="card text-dark">
								<div class="card-header">Цитатник</div>
								<div class="card-body">
									<b>@quote</b>
								</div>
							</div>
						</div>
					}
				</div>
			</div>
		</div>

		if (Model.UserRole == "student")
		{
			<h2>Добро пожаловать @Model.UserName</h2>

			@if (Model.FMTResults.Count > 0)
			{
				<div class="col-md pt-1">
					<h3>Пройденые тесты</h3>
					<table class="table">
						<thead>
							<tr>
								<th>Название</th>
								<th>Организатор</th>
								<th>Время прохождения</th>
								<th>Результат</th>
								<th>Действия</th>
							</tr>
						</thead>
						<tbody>
							@foreach (var result in Model.FMTResults)
							{
								<tr>
									<td>@result.FMTestName</td>
									<td>@result.FMTestOrganizer</td>
									<td>@TimeAgoHelper.GetTimeAgoString(result.PassTime, TimeZoneInfo.Local)</td>
									<td>@result.Result</td>
									<td>
										<a asp-action="FiveMinuteResult" asp-controller="FiveMinuteTest" asp-route-resultId="@result.Id" class="btn btn-primary">Подробнее</a>
									</td>
								</tr>
							}
						</tbody>
					</table>
				</div>
			}
			else
			{
				<div class="text-center p-2">
					<p>Вы пока не прошли ни одного теста.</p>
				</div>
			}
		}
		else
		{
			<div class="container mt-2">
				<h1>Добро пожаловать!</h1>
				<p>Этот сайт предназначен для прохождения быстрых опросников "пятиминуток" для студентов матмеха УрФУ.</p>
				<p>Цитаты выше, это цитаты из цитатника ФИИТ-а. Пускай весь мир видет какие у нас крутые преподаватели!</p>
				<p>По всем вопросам, обращатесь к https://t.me/F1Soda</p>

			</div>
		}
	}

}

@section Scripts {
	<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
	<script>
		const deleteTemplateUrl = '@Url.Action("DeleteTemplate")';
		const deleteTestUrl = '@Url.Action("DeleteTest")';
	</script>
	<script src="~/js/popup.js"></script>
	<script src="~/js/Home/index.js"></script>
	<!-- Подключение Bootstrap CSS и JS для работы вкладок -->
	<link href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css" rel="stylesheet">

	<script src="https://cdn.jsdelivr.net/npm/@@popperjs/core@2.9.2/dist/umd/popper.min.js"></script>
	<script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
}


